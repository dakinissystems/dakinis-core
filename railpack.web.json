{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": { "node": "20" },
  "steps": {
    "build": {
      "inputs": ["...", { "local": true, "include": ["."] }],
      "commands": ["npm run build -w @dakinis/web"]
    }
  },
  "deploy": {
    "startCommand": "npm run preview -w @dakinis/web -- --host 0.0.0.0 --port ${PORT:-8080}"
  }
}
