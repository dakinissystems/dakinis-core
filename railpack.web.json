{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": { "node": "20" },
  "steps": {
    "install": {
      "commands": ["npm install"]
    },
    "build": {
      "inputs": [{ "step": "install" }],
      "commands": ["npm run build -w @dakinis/web"]
    }
  },
  "deploy": {
    "startCommand": "npm run start:web"
  }
}
