# WhatsApp Cloud API (Meta) — configurar solo en Railway/secretos, nunca en git
# Tras exponer un token en chat o repo: revocar en Meta Business Suite y generar uno nuevo.

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=v22.0

# Tenant por defecto para webhooks (id o slug del negocio en Core)
WHATSAPP_DEFAULT_BUSINESS_ID=

# Envío automático en eventos booking.created, order.ready, etc. (requiere phone + message en el evento)
DAKINIS_WHATSAPP_AUTO_SEND=false
