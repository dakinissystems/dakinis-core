# Copiar a .env.local — NO commitear valores reales

# API dev (proxy Vite → core-api)
# VITE_DEV_API_PROXY=http://127.0.0.1:8787

# Sentry (opcional) — proyecto React en sentry.io
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
# Botón "Break the world" en prod (solo para verify puntual; luego false)
# VITE_SENTRY_TEST_BUTTON=true
# VITE_SENTRY_RELEASE=<git-sha o versión>
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# VITE_SENTRY_REPLAY_SESSION_SAMPLE_RATE=0.05
# VITE_SENTRY_REPLAY_ON_ERROR_SAMPLE_RATE=1
