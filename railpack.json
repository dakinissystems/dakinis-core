{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": { "node": "20" },
  "steps": {
    "install": {
      "inputs": [{ "local": true, "include": ["."] }],
      "commands": [
        { "cmd": "npm install", "customName": "Install dependencies (npm install)" }
      ]
    }
  },
  "deploy": {
    "startCommand": "npm run start -w @dakinis/api"
  }
}
