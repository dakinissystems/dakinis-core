# --- API (servicio Web en Render: Node, carpeta raiz del repo) ---
PORT=8787
# SQLite persistente en Render: montar disco y apuntar aqui
SQLITE_PATH=./data/dakinis.db
# URL publica del SPA (sin barra final). En Render: Static Site del frontend.
# Debe coincidir con el origen desde el que el navegador llama a la API.
CORS_ORIGIN=https://tu-frontend.onrender.com

# JWT (obligatorio en produccion: NODE_ENV=production exige >=32 caracteres y distinto del demo)
# JWT_SECRET=

# Administracion plataforma (opcional en demo)
# Secreto Base32 para Google Authenticator / TOTP del usuario platform_admin (sin esto, login solo con password)
# DAKINIS_PLATFORM_TOTP_SECRET=

# --- Frontend (build estatico: npm run build en workspace web) ---
# URL base de la API (sin barra final). En Render: URL del **servicio Node/API**
# (ej. https://dakinis-api.onrender.com), NUNCA la URL del Static Site del SPA.
# Si VITE_API_BASE_URL apunta al sitio estatico, /api/auth/login devuelve HTML (index.html),
# el cliente no puede parsear JSON y el login falla ("Cannot read properties of null").
VITE_API_BASE_URL=

# Opcional: proxy dev hacia otro puerto/host de la API
# VITE_DEV_API_PROXY=http://127.0.0.1:8787

# URL del sitio corporativo (cabecera/pie: logo → marketing). Por defecto en codigo: dakinissystems.onrender.com
# VITE_MARKETING_SITE_URL=https://dakinissystems.onrender.com/
