# Frontend (Vite)
# Deja VITE_API_BASE_URL vacío para usar el proxy `/api` de Vite contra localhost:8787
VITE_API_BASE_URL=
VITE_API_KEY=dakinis-dev-key
VITE_BUSINESS_ID=clinica-demo

# Si .env existe con VITE_API_KEY= sin valor (linea vacia),
# antes provocaba enviar "" y 401 — deja esta linea con la clave o borrala por completo.

# API Node
PORT=8787
JWT_SECRET=cambia_esto_en_produccion
SQLITE_PATH=./data/dakinis.db
DAKINIS_MASTER_API_KEY=dakinis-dev-key

# Credenciales seed (admin por tenant): admin@clinica-demo.local / demo123
# También: admin@peluqueria-demo.local, admin@inmobiliaria-demo.local
