# --- API (Railway: servicio dakinis-core) ---
PORT=8787
SQLITE_PATH=./data/dakinis.db
CORS_ORIGIN=https://core.dakinissystems.com

# JWT (obligatorio en produccion)
# JWT_SECRET=
# JWT_STRICT_ISS_AUD=true   # en production se fuerza si no se pone false

# Master API key — en production DEBE estar definida (no uses dakinis-dev-key)
# DAKINIS_MASTER_API_KEY=
# Auto-provision en /api/auth/exchange (solo si el usuario no existe). En production off por defecto.
# DAKINIS_AUTH_EXCHANGE_AUTO_PROVISION=false

# WhatsApp Business webhook — obligatorio en production para aceptar POSTs firmados
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_DEFAULT_BUSINESS_ID=

# Billing platform service (Stripe vive en dakinis-billing, no en Core)
# DAKINIS_BILLING_URL=https://api.dakinissystems.com/billing
# DAKINIS_GATEWAY_URL=https://api.dakinissystems.com
# Internal API (Hub dashboard, tenant-access). Preferencia:
#   DAKINIS_INTERNAL_URL  →  DAKINIS_INTERNAL_API_URL / HUB_INTERNAL_URL  →  GATEWAY/internal
# DAKINIS_INTERNAL_URL=https://api.dakinissystems.com/internal
# DAKINIS_INTERNAL_SERVICE_KEY=
# Alias legacy (también aceptados): DAKINIS_INTERNAL_API_URL, HUB_INTERNAL_URL, DAKINIS_INTERNAL_API_KEY
# DAKINIS_EVENTS_QUEUE=dakinis:events
# REDIS_URL=

# Dakinis AI (Business Advisor — plan Pro)
# DAKINIS_AI_BASE_URL=http://localhost:4020
# DAKINIS_AI_SERVICE_KEY=dev-ai-key-change-in-prod-32chars

# --- Frontend (Railway: Core Front — core.dakinissystems.com) ---
# API_UPSTREAM en serve-production.mjs (no VITE_API_BASE_URL si usas proxy /api)
# VITE_MARKETING_SITE_URL=https://dakinissystems.com/

# Stripe: eliminar de Core Back tras migración — usar dakinis-billing Railway service
