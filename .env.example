# --- API (servicio Web en Render: Node, carpeta raiz del repo) ---
PORT=8787
# SQLite persistente en Render: montar disco y apuntar aqui
SQLITE_PATH=./data/dakinis.db
# URL publica del SPA (sin barra final). En Render: Static Site del frontend.
# Debe coincidir con el origen desde el que el navegador llama a la API.
CORS_ORIGIN=https://tu-frontend.onrender.com

# JWT (produccion: valor largo y secreto)
# JWT_SECRET=

# --- Frontend (build estatico: npm run build en workspace web) ---
# URL base de la API (sin barra final). En Render: URL del servicio API.
# En local vacio = rutas relativas /api + proxy de Vite.
VITE_API_BASE_URL=

# Opcional: proxy dev hacia otro puerto/host de la API
# VITE_DEV_API_PROXY=http://127.0.0.1:8787
